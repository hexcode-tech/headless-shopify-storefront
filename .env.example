# App base URL (e.g. http://localhost:3000 or https://your-site.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
